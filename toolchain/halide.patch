+        .value("RISCV_E", Target::Feature::RISCV_E)
+        .value("RISCV_F", Target::Feature::RISCV_F)
+        .value("RISCV_M", Target::Feature::RISCV_M)
+        .value("RISCV_RELAX", Target::Feature::RISCV_RELAX)
         .value("FeatureEnd", Target::Feature::FeatureEnd);
 
     py::enum_<halide_type_code_t>(m, "TypeCode")
diff --git a/src/CodeGen_RISCV.cpp b/src/CodeGen_RISCV.cpp
index 108ac28d4..d9d81fb4e 100644
--- a/src/CodeGen_RISCV.cpp
+++ b/src/CodeGen_RISCV.cpp
@@ -144,7 +144,7 @@ private:
 CodeGen_RISCV::CodeGen_RISCV(const Target &t)
     : CodeGen_CPU(t) {
     use_llvm_vp_intrinsics = true;
-    user_assert(native_vector_bits() > 0) << "No vector_bits was specified for RISCV codegen; "
+    user_assert(!t.has_feature(Target::RVV) || native_vector_bits() > 0) << "No vector_bits was specified for RISCV codegen; "
                                           << "this is almost certainly a mistake. You should add -rvv-vector_bits_N "
                                           << "to your Target string, where N is the SIMD width in bits (e.g. 128).";
 }
@@ -165,13 +165,28 @@ string CodeGen_RISCV::mattrs() const {
     //   +f Single-Precision Floating-Point,
     //   +d Double-Precision Floating-Point,
     //   +c Compressed Instructions,
-    std::vector<std::string> attrs = {
-        "+m",
-        "+a",
-        "+f",
-        "+d",
-        "+c",
+    // If any of the RISCV_* extension features is set, only the requested
+    // extensions are enabled instead.
+    std::vector<std::string> attrs;
+    const std::vector<std::pair<Target::Feature, const char *>> extensions = {
+        {Target::RISCV_A, "+a"},
+        {Target::RISCV_C, "+c"},
+        {Target::RISCV_D, "+d"},
+        {Target::RISCV_E, "+e"},
+        {Target::RISCV_F, "+f"},
+        {Target::RISCV_M, "+m"},
     };
+    for (const auto &[feature, attr] : extensions) {
+        if (target.has_feature(feature)) {
+            attrs.emplace_back(attr);
+        }
+    }
+    if (attrs.empty()) {
+        attrs = {"+m", "+a", "+f", "+d", "+c"};
+    }
+    if (target.has_feature(Target::RISCV_RELAX)) {
+        attrs.emplace_back("+relax");
+    }
 
     if (target.has_feature(Target::RVV)) {
         attrs.emplace_back("+v");
